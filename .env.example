# Copie a .env.local (dev con `npm run dev`) o a .env (Docker / producción).
# En desarrollo todo es opcional: hay valores de fábrica. En producción
# (NODE_ENV=production) el servidor NO arranca sin estos cuatro, y rechaza los
# valores de fábrica. Genere secretos con: openssl rand -base64 48

# Firma de sesiones y tokens de kiosco (32+ caracteres)
JWT_SECRET=
# Cifrado AES-256-GCM de plantillas faciales (32+ caracteres).
# No lo cambie después de enrolar: las plantillas quedarían ilegibles.
TEMPLATE_KEY=
# Contraseña de los usuarios semilla (12+ caracteres) y PIN de supervisor (6+)
ADMIN_PASSWORD=
SUPERVISOR_PIN=

# Clave para integraciones servidor a servidor (X-API-Key). Opcional; en
# producción debe tener 24+ caracteres o queda desactivada. La UI no la usa.
# DEMO_API_KEY=

# Solo para una demo local con Docker sin secretos propios. Nunca en internet.
# ALLOW_INSECURE_DEFAULTS=true

# SQLite
DATA_DIR=./data
# SANDBOX=true

PORT=47321

# Webhook opcional (HMAC-SHA256 en X-Reloj-Signature)
# WEBHOOK_URL=https://example.com/hooks/reloj
# WEBHOOK_SECRET=cambie-esto

# IA opcional (si falta, briefing y chat usan plantillas SQL)
# Copie este archivo a .env.local (dev) o .env (Docker). Nunca commitee claves reales.

# NVIDIA Nemotron (API catalog: https://build.nvidia.com )
# NVIDIA_API_KEY=nvapi-...
# LLM_PROVIDER=nvidia
# NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_ENABLE_THINKING=1
# LLM_REASONING_BUDGET=4096
# LLM_MAX_TOKENS=2048
# LLM_TIMEOUT_MS=90000

# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# LLM_BASE_URL=https://api.ejemplo.com/v1
# LLM_API_KEY=
# LLM_MODEL=

# OIDC empresarial (stub: GET /api/v1/auth/oidc)
# OIDC_ISSUER=https://idp.example.com
# OIDC_CLIENT_ID=reloj-cr

# Hosts extra para el dev server (tablets/túneles). Sin esquema ni puerto.
# ALLOWED_DEV_ORIGINS=mi-tablet.local,10.0.0.25
